# Copy to .env and adjust. Nothing here needs a paid account.

# --- database ---------------------------------------------------------------
# Local compose stack. Port 5434 rather than 5432 so this can run alongside
# a2transit and pulse; see docker-compose.yml.
DATABASE_URL=postgresql://commonground:commonground@localhost:5434/commonground

# --- real-time --------------------------------------------------------------
# Room events fan out in-process when this is unset, which is correct for a
# single API instance and is how the free-tier deployment runs. Set it to use
# Redis pub/sub across processes.
# REDIS_URL=redis://localhost:6380/0

# --- auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start in production without this set to a real value.
JWT_SECRET=dev-only-do-not-use-in-production

# --- demo accounts ----------------------------------------------------------
# Seeded so the live demo can be tried without registering.
DEMO_USER_PASSWORD=demo-read-only

# --- rate limiting --------------------------------------------------------------
# On by default. Set to false only for the end-to-end suite and the latency
# benchmark, which make many auth calls from one address and would otherwise
# throttle themselves. Pass it to the process, do not `export` it, or `pytest`
# in the same shell will see it and the limiter tests will fail.
# RATE_LIMIT_ENABLED=false

# --- upstream data sources --------------------------------------------------
# MetaBrainz asks for a real contact address on automated requests. Put yours
# here before running any ingest.
USER_AGENT=CommonGround/0.1 (you@example.com)

# Optional tag enrichment. Everything works without it; see docs/data-sources.md
# for why it is off by default.
# LASTFM_API_KEY=
